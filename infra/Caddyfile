# Airlock public front door: automatic HTTPS, proxy to the app on localhost.
# Sign-in (GitHub OAuth + allowlist) is enforced by the app itself.
{$AIRLOCK_DOMAIN:airlock.darkflib.dev} {
	# No `encode`: compression would buffer the Server-Sent Events stream.
	reverse_proxy 127.0.0.1:8000

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		-Server
	}

	request_body {
		max_size 25MB
	}
}
