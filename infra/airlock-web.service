[Unit]
Description=Airlock web control plane
After=network-online.target
Wants=network-online.target

[Service]
User=airlock
Group=airlock
WorkingDirectory=/home/airlock/airlock
# VULTR_INFERENCE_API_KEY; mode 600, written by scripts/install-web.sh
EnvironmentFile=/home/airlock/.config/airlock/web.env
# Labels this service's VMs, so startup clears only its own leftovers (airlock/sandbox.py reap_leftovers)
Environment=AIRLOCK_VM_OWNER=web
# One worker on purpose: GitHub writes per commit are serialized by an in-process lock (airlock/web/app.py commit_lock)
ExecStart=/home/airlock/airlock/.venv/bin/uvicorn airlock.web.app:app_factory --factory --host 127.0.0.1 --port 8000 --proxy-headers --no-server-header --timeout-graceful-shutdown 5
# On stop: open requests (live streams) get 5 s, then runs in progress get AIRLOCK_DRAIN_S (75 s)
# to finish; anything left is retried on the next start (airlock/web/app.py Runner.drain, recover)
TimeoutStopSec=100
# SIGTERM to uvicorn only: the default sends it to the whole cgroup, so the microVMs died with it
# and the drain had nothing left to wait for. Leftovers get SIGKILL once uvicorn exits.
KillMode=mixed
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
