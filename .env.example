# Copy to .env (gitignored). Secrets are 1Password references, never values:
# scripts/deploy.sh and scripts/remote.sh resolve them with `op read` and send the
# values to the host over SSH stdin. Replace each vault/item/field with your own.
# Setup walk-through: docs/SELF_HOSTING.md

# --- Secrets (op:// references) ---

# Vultr Serverless Inference API key: the agent's model calls (roles.toml picks the model)
VULTR_INFERENCE_API_KEY="op://Private/Airlock/inference-api-key"

# GitHub OAuth App: sign-in to the web UI (callback https://<domain>/auth/callback)
GITHUB_CLIENT_ID="op://Private/Airlock OAuth/client-id"
GITHUB_CLIENT_SECRET="op://Private/Airlock OAuth/client-secret"

# GitHub App: reads PRs, posts the `airlock` commit status and the PR comment
GITHUB_APP_ID="op://Private/Airlock GitHub App/app-id"
GITHUB_APP_PRIVATE_KEY="op://Private/Airlock GitHub App/private-key"   # the .pem, as text
# Webhook secret; leave the field empty in 1Password to turn automatic PR runs off
GITHUB_WEBHOOK_SECRET="op://Private/Airlock GitHub App/webhook-secret"

# Optional, for provisioning from your laptop with the Vultr CLI or API (not used by Airlock itself)
# VULTR_API_KEY="op://Private/Vultr/api-key"

# --- Settings (plain values, not secrets) ---

# SSH target for deploy.sh, remote.sh, allow.sh and invite.sh
AIRLOCK_HOST="airlock@airlock.example.com"
# Public origin; Caddy gets a certificate for this domain. https://<domain>, no path or port
AIRLOCK_PUBLIC_URL="https://airlock.example.com"
# GitHub logins that own this instance (comma-separated). Required: owners see every run
AIRLOCK_OWNERS="your-github-login"
# Repos whose PRs run automatically from the webhook, and the only repos guests may submit
AIRLOCK_GUEST_REPOS="your-org/your-demo-repo"
# Optional: runs at once (default: twice the host's core count). Each VM is 2 vCPU / 2 GB; a PR run uses two
# AIRLOCK_SLOTS="4"
